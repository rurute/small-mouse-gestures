{
  "manifest_version": 3,
  "name": "small mouse gestures",
  "version": "0.1.0",
  "description": "ブラウザをマウスジェスチャで操作します。右ドラッグで戻る・進む・タブの開閉・スクロールを実行。閲覧履歴も URL も読まず、外部通信は一切ありません。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "sessions"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/loader.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/*.js", "src/shared/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "src/options/options.html"
}
